{
  "name": "@deepseek-ai/dsh-client-ui-vision",
  "description": "Vision image-recognition settings card for the configurable-plugins tab",
  "version": "0.1.0-rc.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-vision"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.2-alpha.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-connection": ">=0.1.2-alpha.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-alpha.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-store": ">=0.1.2-alpha.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.1.2-alpha.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.2-alpha.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.2-alpha.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.2-alpha.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-settings-plugins": ">=0.1.2-alpha.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-alpha.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-tool": ">=0.1.2-alpha.1 <0.2.0-0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.2-alpha.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-connection": ">=0.1.2-alpha.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-alpha.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-store": ">=0.1.2-alpha.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.1.2-alpha.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.2-alpha.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.2-alpha.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.2-alpha.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-settings-plugins": ">=0.1.2-alpha.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-alpha.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-tool": ">=0.1.2-alpha.1 <0.2.0-0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "dependencies": {
    "clsx": "^2.0.0"
  }
}
